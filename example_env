# Example Environment File
# Rename this file to '.env' and update with your actual credentials

# Alpaca API Configuration
APCA_API_KEY_ID=your_API_KEY_ID_here
APCA_SECRET_KEY=your_secret_key_here

# Note: BASE_URL is automatically handled by the SDK based on paper/live trading mode
# Paper: https://paper-api.alpaca.markets
# Live: https://api.alpaca.markets

# Risk-free rate for calculations (2% annual)
RISK_FREE_RATE=0.02

# Instructions:
# 1. Rename this file from 'example.env' to '.env'
# 2. Replace 'your_secret_key_here' with your actual Alpaca secret key
# 3. The API key provided is for paper trading only
# 4. Never commit your .env file to version control 